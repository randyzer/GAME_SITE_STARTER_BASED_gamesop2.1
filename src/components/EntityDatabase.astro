---
import EntityFilterIsland from "./islands/EntityFilterIsland";
import type { EntityDatabaseRow } from "../core/filter-state";
import type { PageInventoryEntry } from "../data/schemas/page-inventory";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  page: PageInventoryEntry;
  rows: EntityDatabaseRow[];
  entityLabel: string;
  view: "hub" | "database";
}

const { page, rows, entityLabel, view } = Astro.props;
---

<BaseLayout page={page}>
  <main
    id="main-content"
    class="entity-database shell"
    data-pagefind-body={page.indexability === "index" ? true : undefined}
  >
    <header class="entity-database__header reveal reveal--1">
      <div>
        <p class="eyebrow">{view === "hub" ? "Module index" : "Structured database"} / {rows.length.toString().padStart(2, "0")} records</p>
        <h1 data-pagefind-meta="title">{page.title}</h1>
      </div>
      <p data-pagefind-meta="description">{page.description}</p>
    </header>

    <EntityFilterIsland rows={rows} entityLabel={entityLabel} client:visible />

    <p class="table-scroll__hint">
      Scroll horizontally on narrow screens. Facts are generated from one validated module file.
    </p>
  </main>
</BaseLayout>
